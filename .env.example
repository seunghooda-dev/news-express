OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
NEWS_SUMMARY_GEMINI_SOURCE_MAX_CHARS=2400
NEWS_SUMMARY_DB=data/news_summary.sqlite
DATABASE_URL=
# PostgreSQL example:
# DATABASE_URL=postgresql://kbcnews:비밀번호@발급받은호스트:5432/kbcnews?sslmode=require
NEWS_SUMMARY_CONFIG=config/municipalities.yaml
NEWS_SUMMARY_EXPORT_DIR=exports
NEWS_SUMMARY_BACKUP_DIR=data/backups
NEWS_SUMMARY_LOG_DIR=data/logs
NEWS_SUMMARY_RETENTION_DAYS=3
NEWS_SUMMARY_RETENTION_HOLIDAYS=
NEWS_SUMMARY_ADMIN_PASSWORD=
# 운영 관리 진입 전용 비밀번호. 관리자 로그인과 별개로 운영관리 화면 진입 시 확인한다.
# admin-password-hash 명령 등으로 만든 해시를 NEWS_SUMMARY_OPERATIONS_PASSWORD_HASH에 넣는다.
# (평문 NEWS_SUMMARY_OPERATIONS_PASSWORD도 지원하지만 해시 사용을 권장한다.)
NEWS_SUMMARY_OPERATIONS_PASSWORD_HASH=
NEWS_SUMMARY_AUTH_REQUIRED=0
NEWS_SUMMARY_AUTH_DISABLED=1
NEWS_SUMMARY_SECRET_KEY=
